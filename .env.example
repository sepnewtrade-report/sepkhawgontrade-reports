# Financial News Intelligence & MCP Pipeline Configuration
# Copy this file to .env and insert your API keys

# SEC EDGAR User-Agent (Required format: Sample Company Name AdminContact@<sample company domain>.com)
SEC_EDGAR_USER_AGENT="SepKhawGonTrade intelligence@sepkhawgontrade.com"

# Finnhub API Key (https://finnhub.io)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpha Vantage API Key (https://www.alphavantage.co)
